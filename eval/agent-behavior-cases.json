  {
    "id": "AB009_ranker_failure_fallback",
    "description": "LLM ranker 失败时仍应 deterministic fallback",
    "userInput": "便宜一点，最好连续两小时",
    "observations": [
      {
        "iteration": 1,
        "candidates": [
          {
            "id": "a",
            "price": 20,
            "continuousMinutes": 60
          },
          {
            "id": "b",
            "price": 28,
            "continuousMinutes": 120
          }
        ],
        "rankerFailure": "timeout"
      }
    ],
    "expected": {
      "fallbackUsed": true,
      "rankedCandidateIdsPresent": ["a", "b"],
      "agentContinues": true,
      "providerFailureDoesNotAbortLoop": true
    }
  },
  {
    "id": "AB010_replanning_changes_observation",
    "description": "replanner action 执行后必须产生新的 observation，而不是原地重复",
    "userInput": "便宜一点，最好连续两小时，远一点也行",
    "observations": [
      {
        "iteration": 1,
        "state": {
          "radiusMeters": 3000
        },
        "candidates": [
          {
            "id": "short",
            "continuousMinutes": 60
          }
        ]
      },
      {
        "iteration": 2,
        "afterAction": "EXPAND_RADIUS",
        "state": {
          "radiusMeters": 5000
        },
        "candidates": [
          {
            "id": "long",
            "continuousMinutes": 120
          }
        ]
      }
    ],
    "expected": {
      "firstEvaluation": "NEEDS_REPLANNING",
      "stateChanged": true,
      "observationChanged": true,
      "finalEvaluation": "SATISFACTORY"
    }
  },
  {
