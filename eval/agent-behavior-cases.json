        "EXPAND_VENUE_SET",
        "SWITCH_SEARCH_AREA",
        "ASK_USER"
      ],
      "forbiddenActions": [
        "RELAX_PRICE",
        "EXPAND_DATE_WINDOW",
        "SHIFT_TIME_WINDOW",
        "SEARCH_OTHER_VENUES"
      ],
      "hardConstraintsRelaxed": false,
      "replannerCalled": true
    }
  },
  {
