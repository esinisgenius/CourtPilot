  {
    "id": "AB003_missing_two_hour_slots",
    "description": "当前候选全部只有1小时，应扩大搜索寻找连续两小时",
    "userInput": "明天17点以后，最好连续两小时，远一点也可以",
    "initialState": {
      "radiusMeters": 3000
    },
    "observations": [
      {
        "iteration": 1,
        "candidates": [
          {
            "id": "short-1",
            "continuousMinutes": 60,
            "transitMinutes": 15
          },
          {
            "id": "short-2",
            "continuousMinutes": 60,
            "transitMinutes": 22
          }
        ]
      },
      {
        "iteration": 2,
        "afterAction": "EXPAND_RADIUS",
        "candidates": [
          {
            "id": "two-hour",
            "continuousMinutes": 120,
            "transitMinutes": 31
          }
        ]
      }
    ],
    "expected": {
      "firstEvaluation": "NEEDS_REPLANNING",
      "allowedActions": [
